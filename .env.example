# Isi dari dashboard Neon (Connection string, pilih yang "pooled connection")
DATABASE_URL=postgresql://neondb_owner:npg_xpXmv8qVh6ru@ep-red-flower-b3pvaq65-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# PIN panitia — dipakai untuk DUA hal:
# 1. Masuk ke panel /admin (live monitor peserta)
# 2. Tombol "Paksa Selesaikan" di panel tsb (dikirim sbg body.dipaksaOleh,
#    tersimpan di sesi_tes.finalized_by supaya ada jejak siapa yang memaksa
#    selesaikan sesi siswa)
PANITIA_PIN=ganti-ini

# Kode buka-kunci-mandiri — SENGAJA dipisah dari PANITIA_PIN di atas.
# Ini kode pendek yang boleh diumumkan/diucapkan panitia di ruangan tes saat
# ada peserta yang terkunci karena pelanggaran (pindah tab dll), supaya
# peserta bisa membuka kunci di HP-nya SENDIRI (lihat layar "Tes Dikunci
# Sistem" di app/tes) tanpa panitia harus buka laptop/panel /admin satu-satu.
# Beda dari PANITIA_PIN karena kode ini akan diketahui banyak peserta
# sekaligus -- jangan pakai PIN admin yang sama supaya akses ke panel
# /admin (yang bisa hapus data dll) tidak ikut bocor.
# Ganti kode ini tiap sesi ujian kalau perlu (mis. tiap hari/tiap sesi ujian).
KODE_BUKA_KUNCI_SENDIRI=ganti-ini-juga
